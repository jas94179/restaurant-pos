{
  "$name": "galla Design System",
  "$version": "1.0.0-draft",
  "$description": "Single source of truth for the galla app, web, print and marketing. Values come from the app audit (Oct 2026), cleaned up. Dark mode is defined here; the app ships light only for now.",

  "color": {
    "primitive": {
      "green":    { "900": "#0B1F17", "800": "#0F2A1F", "700": "#17382A", "600": "#1F4A37", "500": "#2C5A44", "400": "#557A68", "300": "#9DB8AA", "200": "#CFE0D6", "100": "#E5EEE9", "50": "#F3F6F4" },
      "turmeric": { "800": "#8A5B00", "600": "#C98C07", "500": "#F2B01E", "300": "#F2C04A", "100": "#FBF0D2", "50": "#FFF6DE" },
      "neutral":  { "900": "#102018", "600": "#5E6E66", "500": "#7D9188", "300": "#DDE3E0", "0": "#FFFFFF" },
      "success":  { "700": "#167A33", "600": "#1B8A3A", "300": "#7ED39A", "100": "#E6F4EA", "dark-bg": "#16351F" },
      "danger":   { "600": "#B3261E", "300": "#FFB4AB", "100": "#FDE7E4", "dark-bg": "#3A1A17" },
      "dark":     { "bg": "#0D1A14", "surface": "#13251C", "raised": "#1A2F24", "line": "#26402F", "tint": "#1C3328", "text": "#E7F0EA", "muted": "#A9BFB2", "accent": "#74CC9E" }
    },
    "semantic": {
      "bg.app":            { "light": "{green.50}",      "dark": "{dark.bg}" },
      "bg.surface":        { "light": "{neutral.0}",     "dark": "{dark.surface}" },
      "bg.raised":         { "light": "{neutral.0}",     "dark": "{dark.raised}",  "$note": "bottom sheets, menus" },
      "bg.brand":          { "light": "{green.700}",     "dark": "{green.800}",    "$note": "headers, hero bands" },
      "bg.selected":       { "light": "{green.100}",     "dark": "{dark.tint}",    "$note": "selected chip, segment, row" },
      "bg.scrim":          { "light": "rgba(15,42,31,0.55)", "dark": "rgba(0,0,0,0.60)" },

      "text.primary":      { "light": "{neutral.900}",   "dark": "{dark.text}" },
      "text.secondary":    { "light": "{neutral.600}",   "dark": "{dark.muted}",   "$note": "also placeholders" },
      "text.onBrand":      { "light": "{neutral.0}",     "dark": "{neutral.0}" },
      "text.onBrandMuted": { "light": "{green.200}",     "dark": "{green.200}" },
      "text.onAccent":     { "light": "{green.800}",     "dark": "{green.800}" },
      "text.link":         { "light": "{green.700}",     "dark": "{dark.accent}" },

      "border.default":    { "light": "{neutral.300}",   "dark": "{dark.line}",    "$note": "dividers, card outlines (decorative)" },
      "border.input":      { "light": "{neutral.500}",   "dark": "{green.400}",    "$note": "inputs and controls, 3:1 contrast" },
      "border.selected":   { "light": "{green.700}",     "dark": "{dark.accent}" },
      "border.focus":      { "light": "{turmeric.500}",  "dark": "{turmeric.500}" },

      "action.primary":        { "light": "{green.700}",    "dark": "{dark.accent}" },
      "action.primary.text":   { "light": "{neutral.0}",    "dark": "{green.900}" },
      "action.primary.pressed":{ "light": "{green.800}",    "dark": "{success.300}" },
      "action.accent":         { "light": "{turmeric.500}", "dark": "{turmeric.500}", "$note": "the one big CTA per screen: Pay, Show UPI QR, Free trial" },
      "action.accent.text":    { "light": "{green.800}",    "dark": "{green.800}" },
      "action.danger":         { "light": "{danger.600}",   "dark": "{danger.300}" },
      "action.danger.text":    { "light": "{neutral.0}",    "dark": "{green.900}" },
      "action.disabled":       { "light": "{neutral.300}",  "dark": "{dark.line}" },
      "action.disabled.text":  { "light": "{neutral.600}",  "dark": "{dark.muted}" },

      "status.success":    { "light": "{success.700}",   "dark": "{success.300}", "$note": "Paid, Cash matches, Saved" },
      "status.success.bg": { "light": "{success.100}",   "dark": "{success.dark-bg}" },
      "status.danger":     { "light": "{danger.600}",    "dark": "{danger.300}",  "$note": "Short, errors, cancelled" },
      "status.danger.bg":  { "light": "{danger.100}",    "dark": "{danger.dark-bg}" },
      "status.warning":    { "light": "{turmeric.800}",  "dark": "{turmeric.300}", "$note": "Extra cash, unsent kitchen items" },
      "status.warning.bg": { "light": "{turmeric.100}",  "dark": "#3A2E10" },
      "status.offline":    { "light": "{turmeric.500}",  "dark": "{turmeric.500}", "$note": "Offline chip fill; text uses text.onAccent" },

      "food.veg":          { "light": "{success.600}",   "dark": "{success.300}" },
      "food.nonVeg":       { "light": "{danger.600}",    "dark": "{danger.300}" }
    }
  },

  "font": {
    "family": {
      "app":       "Bricolage Grotesque",
      "marketing": "Poppins",
      "mono":      "IBM Plex Mono",
      "receipt":   "printer built-in (ESC/POS Font A, 32 columns on 58 mm)"
    },
    "weight": { "regular": 400, "semibold": 600, "bold": 800 },
    "$note": "App UI and product web use Bricolage. Brochures, posts and reels use Poppins. Mono for codes, invoice numbers and receipt previews."
  },

  "type": {
    "display.hero": { "size": 72, "line": 76, "weight": "bold",     "$use": "splash, wordmark" },
    "display":      { "size": 40, "line": 44, "weight": "bold",     "$use": "big totals, onboarding titles" },
    "amount":       { "size": 32, "line": 36, "weight": "bold",     "$use": "QR amount, day-close result; tabular numbers" },
    "title.lg":     { "size": 28, "line": 34, "weight": "bold",     "$use": "screen titles" },
    "title.md":     { "size": 22, "line": 28, "weight": "bold",     "$use": "sheet titles, section heads" },
    "title.sm":     { "size": 18, "line": 24, "weight": "bold",     "$use": "card titles" },
    "body.lg":      { "size": 16, "line": 24, "weight": "regular",  "$use": "inputs, main reading text" },
    "body.md":      { "size": 15, "line": 22, "weight": "regular",  "$use": "list rows, tile names (semibold)" },
    "body.sm":      { "size": 14, "line": 20, "weight": "regular",  "$use": "secondary text, chips (semibold)" },
    "label.lg":     { "size": 16, "line": 20, "weight": "bold",     "$use": "primary buttons" },
    "label.md":     { "size": 15, "line": 20, "weight": "semibold", "$use": "secondary and text buttons" },
    "label.sm":     { "size": 13, "line": 18, "weight": "semibold", "$use": "small buttons, tab labels, badges" },
    "caption":      { "size": 12, "line": 17, "weight": "regular",  "$use": "fine print, timestamps" },
    "$mapping": "From the audit: 11→12, 17→16, 19→18, 20→22, 24→22, 26→28, 30→32, 88→72. 19 sizes become 13 styles."
  },

  "space": {
    "0": 0, "0.5": 2, "1": 4, "1.5": 6, "2": 8, "2.5": 10, "3": 12, "3.5": 14, "4": 16, "5": 20, "6": 24, "7": 28, "8": 32, "10": 40, "12": 48, "16": 64,
    "$note": "4-point scale with half steps for dense counter screens. Audit odd values 3, 5, 7, 9, 22, 36, 60, 96 map to the nearest step. Screen side padding = 16."
  },

  "radius": {
    "none": 0, "xs": 4, "sm": 8, "md": 12, "lg": 14, "xl": 16, "2xl": 20, "3xl": 28, "full": 999,
    "$use": { "xs": "veg mark, small badges", "sm": "small buttons", "md": "inputs, tiles, segments", "lg": "buttons", "xl": "cards", "2xl": "big panels", "3xl": "bottom sheet top corners", "full": "chips, avatars, pills" },
    "$mapping": "24 radii in the audit become 9."
  },

  "size": {
    "control.sm": 36, "control.md": 44, "control.lg": 52, "input": 48, "touch.min": 44,
    "icon.sm": 16, "icon.md": 20, "icon.lg": 24, "avatar.sm": 24, "avatar.md": 40, "tabBar": 64,
    "$mapping": "Button heights 44/46/48/50/52/54 become 44 (secondary) and 52 (primary). Inputs 48/50 become 48."
  },

  "border": { "hairline": 1, "default": 1.5, "selected": 2 },

  "elevation": {
    "0":  "none",
    "1":  "0 1 2 rgba(16,32,24,0.08)",
    "2":  "0 8 24 rgba(16,32,24,0.12)",
    "3":  "0 24 48 rgba(16,32,24,0.18)",
    "$use": { "0": "app default: flat with borders", "1": "web cards on hover", "2": "bottom sheets, menus, toasts", "3": "marketing mockups" }
  },

  "motion": {
    "duration": { "fast": 120, "base": 200, "sheet": 260 },
    "easing": { "enter": "cubic-bezier(0.33, 1, 0.68, 1)", "exit": "cubic-bezier(0.32, 0, 0.67, 0)" },
    "$note": "From BottomSheet: opens 260 ms ease-out cubic, closes 200 ms ease-in cubic. Respect reduced motion."
  },

  "print": {
    "paper": "58 mm thermal (57 mm), 32 characters per line",
    "charset": "ASCII only; amounts as 'Rs', separators as '-'",
    "styles": { "title": "double size, bold, centred", "section": "bold", "body": "normal", "rule": "32 dashes" }
  }
}
